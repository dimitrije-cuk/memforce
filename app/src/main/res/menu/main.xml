<?xml version="1.0" encoding="utf-8"?>
<!--
    The menu of the home screen. The first group names the signed-in user and is disabled, because
    it reports rather than acts; the second holds the ways off this screen. The user item and the
    lobby item each carry a value that changes, so the title given here is only what they read
    before the screen fills them in as the menu is opened.
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android">

    <group android:id="@+id/menuGroupAccount">

        <item
            android:id="@+id/menuSignedInAs"
            android:enabled="false"
            android:title="@string/menu_account" />

    </group>

    <group android:id="@+id/menuGroupNavigation">

        <item
            android:id="@+id/menuLobby"
            android:title="@string/lobby_title" />

        <item
            android:id="@+id/menuQuestions"
            android:title="@string/menu_questions" />

        <item
            android:id="@+id/menuTags"
            android:title="@string/menu_tags" />

        <item
            android:id="@+id/menuSignOut"
            android:title="@string/menu_sign_out" />

    </group>

</menu>
