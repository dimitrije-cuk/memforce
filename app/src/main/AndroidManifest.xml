<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MemForce">

        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.MainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.tag.TagListActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.tag.TagEditActivity"
            android:exported="false"
            android:parentActivityName=".ui.tag.TagListActivity" />

        <activity
            android:name=".ui.category.CategoryListActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.category.CategoryEditActivity"
            android:exported="false"
            android:parentActivityName=".ui.category.CategoryListActivity" />

        <activity
            android:name=".ui.question.QuestionListActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <activity
            android:name=".ui.question.QuestionEditActivity"
            android:exported="false"
            android:parentActivityName=".ui.question.QuestionListActivity" />
    </application>

</manifest>
